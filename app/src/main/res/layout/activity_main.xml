<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnglish"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_english" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBangla"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_bangla" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/green_900"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvLowStockWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@color/red_100"
            android:padding="12dp"
            android:textColor="@color/red_600"
            android:textStyle="bold"
            android:visibility="gone" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <com.gaikhamar.app.ui.cview.CountTileView
                android:id="@+id/tileTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:tileLabel="@string/total" />

            <com.gaikhamar.app.ui.cview.CountTileView
                android:id="@+id/tileBeef"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:tileLabel="@string/beef" />

            <com.gaikhamar.app.ui.cview.CountTileView
                android:id="@+id/tileDairy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:tileLabel="@string/dairy" />

            <com.gaikhamar.app.ui.cview.CountTileView
                android:id="@+id/tileCalf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:tileLabel="@string/calves" />

            <com.gaikhamar.app.ui.cview.CountTileView
                android:id="@+id/tilePregnant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:tileLabel="@string/pregnant" />

            <com.gaikhamar.app.ui.cview.CountTileView
                android:id="@+id/tileSick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:tileLabel="@string/sick" />

            <com.gaikhamar.app.ui.cview.CountTileView
                android:id="@+id/tileFeedToday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:tileLabel="@string/feed_today" />

            <com.gaikhamar.app.ui.cview.CountTileView
                android:id="@+id/tileLowStock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:tileLabel="@string/low_stock" />
            <com.gaikhamar.app.ui.cview.CountTileView
                android:id="@+id/tileMilkToday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:tileLabel="@string/milk_today" />

            <com.gaikhamar.app.ui.cview.CountTileView
                android:id="@+id/tileCalvingSoon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:tileLabel="@string/calving_soon" />
        </GridLayout>

        <TextView
            android:id="@+id/tvCostPerAnimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/green_900"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnimals"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/animals" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAnimal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/add_animal" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMilk"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/milk_records" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatches"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/batches" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFeedLog"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/feed_log" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFeedStock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/feed_stock" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/logout" />
    </LinearLayout>
</ScrollView>